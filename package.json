{
  "name": "tripmate-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:functions": "npx -y deno@2.1.4 check supabase/functions/generate-itinerary/index.ts supabase/functions/trips/index.ts supabase/functions/trip-assistant/index.ts",
    "test": "node --experimental-strip-types --no-warnings --test tests/backend/*.test.ts",
    "test:integration": "node --experimental-strip-types --no-warnings --test tests/integration/*.test.ts",
    "mock-llm": "node --experimental-strip-types --no-warnings tests/integration/mock-llm-server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "@vis.gl/react-google-maps": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.6"
  }
}
