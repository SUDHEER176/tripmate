rules_version = '2';

// Browsers never read or write Firestore directly: every request goes through
// the API (Cloud Function), which uses the Admin SDK and checks that the
// signed-in user owns the trip. The Admin SDK is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
