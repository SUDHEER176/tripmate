# TripMate AI Environment Configuration
# Copy this file to .env.local to connect to your Supabase project

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: use the local backend (cd backend && npm start) instead of the
# Edge Functions deployed on Supabase. Leave empty to use Supabase.
VITE_API_URL=
# VITE_API_URL=http://localhost:8000/functions/v1

# Google Maps (optional). Without a key the app falls back to OpenStreetMap.
# Enable "Maps JavaScript API" in Google Cloud, then restrict the key to your
# domains (HTTP referrers) — it is public in the browser bundle.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (needed for markers in production)
VITE_GOOGLE_MAPS_MAP_ID=

# ------------------------------------------------------------------
# Edge Function secrets — NEVER put these in this file or any VITE_ var.
# Set them on the server instead:
#   supabase secrets set LLM_API_KEY=sk-...           (or OPENAI_API_KEY)
# Optional: LLM_BASE_URL, LLM_MODEL, LLM_TIMEOUT_MS, LLM_MAX_TOKENS,
#           AI_RATE_LIMIT_PER_HOUR, AI_RATE_LIMIT_PER_DAY,
#           WRITE_RATE_LIMIT_PER_MINUTE, ALLOWED_ORIGINS
#   supabase secrets set GOOGLE_ROUTES_API_KEY=...    (Routes API; a separate, server-only key)
# ------------------------------------------------------------------
