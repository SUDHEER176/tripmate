# TripMate AI frontend configuration. Copy this file to .env.local.

# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public by design. Leave them empty for local demo mode, which
# stores trips in this browser and needs no server.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development: where `npm run dev` proxies /api to (cd backend && npm start).
VITE_DEV_API_TARGET=http://localhost:8000
# Set to http://127.0.0.1:9099 to sign in against the Auth emulator
# (cd backend && npm run emulators). Use VITE_FIREBASE_PROJECT_ID=demo-tripmate with it.
VITE_FIREBASE_AUTH_EMULATOR=

# Google Maps (optional). Without a key the app falls back to OpenStreetMap.
# Enable "Maps JavaScript API" in Google Cloud, then restrict the key to your
# domains (HTTP referrers) — it is public in the browser bundle.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (needed for markers in production)
VITE_GOOGLE_MAPS_MAP_ID=

# Server secrets (LLM keys, service accounts) belong in the backend, never in a
# VITE_ variable: everything here is public in the browser bundle.
