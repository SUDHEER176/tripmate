# Settings for the LOCAL backend server (npm start). Copy this file to
# .env.local and fill it in. Never commit it. `firebase deploy` never uploads
# .env.local; for Cloud Functions see "Deploy" in the README.

PORT=8000

# --- Firebase ----------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account key (Firebase console > Project settings > Service accounts >
# Generate new private key). Keep the file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Or run against the local emulators (npm run emulators) instead of a real project:
# FIREBASE_PROJECT_ID=demo-tripmate
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# 6-digit email codes are sent with Resend (https://resend.com). Without a key,
# codes are printed to this server's console (development only).
RESEND_API_KEY=
EMAIL_FROM=TripMate <onboarding@resend.dev>

# --- AI provider (any OpenAI-compatible API) ---------------------------------
LLM_API_KEY=
# For Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Optional: real travel times for route optimization
GOOGLE_ROUTES_API_KEY=

# Extra browser origins allowed to call the API directly (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# --- One-time data import (npm run import-supabase) ---------------------------
# Supabase > Project Settings > Database > Connection string (session pooler, URI).
SUPABASE_DB_URL=
