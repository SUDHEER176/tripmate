# Settings for the local backend server (npm start).
# Copy this file to .env and fill it in. Never commit .env.
#
# On Supabase these are set with `npx supabase secrets set ...` instead;
# SUPABASE_URL and SUPABASE_ANON_KEY are provided there automatically.

PORT=8000

# Your Supabase project (Project Settings > API). Same values as the frontend.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# AI provider (any OpenAI-compatible API)
LLM_API_KEY=
# For Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Optional: real travel times for route optimization
GOOGLE_ROUTES_API_KEY=

# Browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
